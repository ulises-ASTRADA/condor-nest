NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
INGEST_TOKEN=<value of cn_secrets.ingest_token>
AFFILIATE_URL=<Mercado Libre affiliate link; falls back to a plain public listing>
CRON_SECRET=<random string; Vercel sends it as Bearer on cron calls>
SUPABASE_SERVICE_ROLE_KEY=<server-only secret key; NEVER prefix with NEXT_PUBLIC_>
TURNSTILE_SECRET_KEY=<optional; enables Turnstile check on signup>
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<optional; Turnstile widget site key>

SITE_URL=https://condor-nest.lat
RESEND_API_KEY=<server-only Resend key>
RESEND_FROM=Condor Nest <hola@condor-nest.lat>  # only after Resend domain verified
PUBLICAR_NOTIFY_TO=<owner email for /publicar notices>

# Listing funnel: both flags + VERCEL_ENV=production required. Apply the migration first.
# Leave unset in local/previews; opt out in your browser with localStorage['cn-analytics-opt-out']='1'.
NEXT_PUBLIC_LISTING_ANALYTICS_ENABLED=0
LISTING_ANALYTICS_ENABLED=0
