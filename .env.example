NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
INGEST_TOKEN=<value of cn_secrets.ingest_token>
AFFILIATE_URL=<Mercado Libre affiliate link; falls back to a plain public listing>
CRON_SECRET=<random string; Vercel sends it as Bearer on cron calls>
SUPABASE_SERVICE_ROLE_KEY=<server-only secret key; NEVER prefix with NEXT_PUBLIC_>
TURNSTILE_SECRET_KEY=<optional; enables Turnstile check on signup>
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<optional; Turnstile widget site key>
